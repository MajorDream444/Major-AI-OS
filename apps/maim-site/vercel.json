{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 maim/build.py",
  "outputDirectory": "maim/dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/pillars",
      "destination": "/pillars.html"
    },
    {
      "source": "/return",
      "destination": "/return.html"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/shop/pillar-scroll",
      "destination": "/shop/pillar-scroll.html"
    },
    {
      "source": "/coaching",
      "destination": "/coaching.html"
    },
    {
      "source": "/library",
      "destination": "/library.html"
    },
    {
      "source": "/vault",
      "destination": "/vault.html"
    },
    {
      "source": "/campus",
      "destination": "/campus.html"
    },
    {
      "source": "/checkout/return",
      "destination": "/checkout/return.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/blueprint/blueprint-terms-2026-10-16-draft.1",
      "destination": "/terms/blueprint/blueprint-terms-2026-10-16-draft.1.html"
    },
    {
      "source": "/terms/blueprint/blueprint-terms-2026-10-16.1",
      "destination": "/terms/blueprint/blueprint-terms-2026-10-16.1.html"
    },
    {
      "source": "/terms/blueprint/blueprint-terms-2026-10-16.2",
      "destination": "/terms/blueprint/blueprint-terms-2026-10-16.2.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/maim/maim-privacy-2026-10-16.1",
      "destination": "/privacy/maim/maim-privacy-2026-10-16.1.html"
    }
  ],
  "redirects": [
    {
      "source": "/10-pillars",
      "destination": "/pillars",
      "permanent": true
    },
    {
      "source": "/thank-you",
      "destination": "/return",
      "permanent": false
    },
    {
      "source": "/academy",
      "destination": "https://academy.majoraimindset.com/",
      "permanent": false
    },
    {
      "source": "/academy/:path*",
      "destination": "https://academy.majoraimindset.com/:path*",
      "permanent": false
    },
    {
      "source": "/reserve",
      "destination": "https://academy.majoraimindset.com/reserve",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/shop",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://code.iconify.design https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://vitals.vercel-insights.com; frame-src https://checkout.stripe.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(favicon|social-preview).(png|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/funnel-reconciled-2026-10-27": false
    }
  }
}
